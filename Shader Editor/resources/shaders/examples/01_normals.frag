#version 330 core

in vec3 vNormal;

out vec4 FragColor;

// Пример 1. Визуализация нормалей.
// Каждый пиксель окрашивается по направлению нормали: (+X) красный,
// (+Y) зелёный, (+Z) синий. Классический инструмент отладки геометрии:
// если модель «рассыпается» на пятна - проблема в нормалях или индексах.

void main()
{
    FragColor = vec4(vNormal * 0.5 + 0.5, 1.0);
}
